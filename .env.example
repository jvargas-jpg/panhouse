NODE_ENV=development
PORT=3000

# --- Docker Compose: Postgres ---
# Puertos configurables para no chocar con otros contenedores locales.
POSTGRES_USER=panhouse
POSTGRES_PASSWORD=panhouse
POSTGRES_DB=panhouse
POSTGRES_PORT=5432

# --- Docker Compose: Redis ---
REDIS_PORT=6379

# --- Conexión de la aplicación (debe coincidir con las variables de arriba) ---
DATABASE_URL=postgres://panhouse:panhouse@localhost:5432/panhouse
REDIS_URL=redis://localhost:6379

# --- Sesión (cookie httpOnly) ---
SESSION_COOKIE_NAME=panhouse_sid
SESSION_TTL_HOURS=24
# true solo detrás de HTTPS (producción). En local, false.
COOKIE_SECURE=false

# --- SSO con el portal de pago ---
# Diseño asumido, pendiente de confirmar con el equipo de pagos (ver
# server/helpers/pagos.ts). PAYMENT_SSO_SECRET es una clave compartida
# real que hay que intercambiar con ellos — el valor de abajo es un
# placeholder, nunca un secreto válido.
PAYMENT_SSO_SECRET=pendiente_de_coordinar_con_equipo_pagos
PAYMENT_PORTAL_URL=https://pagos.pendiente-de-coordinar.example
